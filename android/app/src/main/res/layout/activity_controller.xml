<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
        android:keepScreenOn="true"
        tools:context=".ui.ControllerActivity">

    <!-- Barra de status: indicador de conexão + desconectar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/status_dot" />

        <TextView
            android:id="@+id/textViewConnectionStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/status_connected"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDisconnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/button_disconnect"
            android:textSize="14sp"
            app:cornerRadius="8dp" />
    </LinearLayout>

        <!-- Modo Volante: toggle + estado + recenter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchWheelMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wheel_mode"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textWheelModeState"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/wheel_mode_off"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRecenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/button_recenter"
                android:textSize="14sp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Painel do volante (visível apenas com Modo Volante ativado) -->
        <LinearLayout
            android:id="@+id/steeringPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:visibility="gone"
            tools:visibility="visible">

            <com.phonewheel.ui.SteeringWheelView
                android:id="@+id/steeringWheel"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <com.phonewheel.ui.SteeringIndicatorView
                    android:id="@+id/steeringIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />

                <TextView
                    android:id="@+id/textWheelValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0.00"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Área do gamepad -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
            android:padding="4dp">

        <!-- Coluna esquerda: LB/LS, D-pad, analógico esquerdo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal">

                    <com.phonewheel.ui.controls.VirtualButton
                        android:id="@+id/buttonLB"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="4dp" />

                    <com.phonewheel.ui.controls.VirtualButton
                        android:id="@+id/buttonLS"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="4dp" />
                </LinearLayout>

                <com.phonewheel.ui.controls.VirtualDPad
                    android:id="@+id/dpad"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp" />

                <com.phonewheel.ui.controls.VirtualAnalogStick
                    android:id="@+id/leftStick"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_margin="4dp" />
            </LinearLayout>

            <!-- Coluna central: Back, Start -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <com.phonewheel.ui.controls.VirtualButton
                    android:id="@+id/buttonBack"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_margin="8dp" />

                <com.phonewheel.ui.controls.VirtualButton
                    android:id="@+id/buttonStart"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_margin="8dp" />
            </LinearLayout>

            <!-- Coluna direita: RB/RS, A/B/X/Y, analógico direito -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal">

                    <com.phonewheel.ui.controls.VirtualButton
                        android:id="@+id/buttonRB"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="4dp" />

                    <com.phonewheel.ui.controls.VirtualButton
                        android:id="@+id/buttonRS"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_margin="4dp" />
                </LinearLayout>

                <!-- Diamond A/B/X/Y -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <com.phonewheel.ui.controls.VirtualButton
                            android:id="@+id/buttonX"
                            android:layout_width="64dp"
                            android:layout_height="match_parent"
                            android:layout_margin="4dp" />

                        <com.phonewheel.ui.controls.VirtualButton
                            android:id="@+id/buttonY"
                            android:layout_width="64dp"
                            android:layout_height="match_parent"
                            android:layout_margin="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                    android:orientation="horizontal">

                    <com.phonewheel.ui.controls.VirtualButton
                        android:id="@+id/buttonA"
                        android:layout_width="64dp"
                            android:layout_height="match_parent"
                        android:layout_margin="4dp" />

                    <com.phonewheel.ui.controls.VirtualButton
                        android:id="@+id/buttonB"
                        android:layout_width="64dp"
                            android:layout_height="match_parent"
                        android:layout_margin="4dp" />
                </LinearLayout>
            </LinearLayout>

            <com.phonewheel.ui.controls.VirtualAnalogStick
                android:id="@+id/rightStick"
                    android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                    android:layout_margin="4dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>