<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:keepScreenOn="true"
    tools:context=".ui.ControllerActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- ===== LEFT COLUMN (25%) ===== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="25"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <!-- LT trigger button -->
            <com.phonewheel.ui.controls.VirtualButton
                android:id="@+id/buttonLT"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_margin="4dp" />

            <!-- LB shoulder button -->
            <com.phonewheel.ui.controls.VirtualButton
                android:id="@+id/buttonLB"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_margin="4dp" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- D-Pad -->
            <com.phonewheel.ui.controls.VirtualDPad
                android:id="@+id/dpad"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:layout_margin="4dp" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Hidden views required for binding compatibility -->
            <com.phonewheel.ui.controls.VirtualButton
                android:id="@+id/buttonLS"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                tools:ignore="VisualClickability" />

            <com.phonewheel.ui.controls.VirtualAnalogStick
                android:id="@+id/leftStick"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                tools:ignore="VisualClickability" />

        </LinearLayout>

        <!-- ===== CENTER COLUMN (50%) ===== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="50"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <!-- Status bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/status_dot" />

                <TextView
                    android:id="@+id/textViewConnectionStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/status_connected"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonDisconnect"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/button_disconnect"
                    android:textSize="12sp"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />
            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Steering Wheel (main element - large) -->
            <com.phonewheel.ui.SteeringWheelView
                android:id="@+id/steeringWheel"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center" />

            <!-- Steering Indicator -->
            <com.phonewheel.ui.SteeringIndicatorView
                android:id="@+id/steeringIndicator"
                android:layout_width="200dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:layout_marginTop="8dp" />

            <!-- Wheel value text -->
            <TextView
                android:id="@+id/textWheelValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"
                android:text="0.00"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Recenter button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRecenter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="8dp"
                android:text="@string/button_recenter"
                android:textSize="13sp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Settings gear button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSettings"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="8dp"
                android:text="⚙ Config"
                android:textSize="13sp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <!-- Hidden views required for binding compatibility -->
            <LinearLayout
                android:id="@+id/steeringPanel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                tools:ignore="VisualClickability" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchWheelMode"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                tools:ignore="VisualClickability" />

            <TextView
                android:id="@+id/textWheelModeState"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                tools:ignore="VisualClickability" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonInvertWheel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                tools:ignore="VisualClickability" />

            <com.phonewheel.ui.controls.VirtualButton
                android:id="@+id/buttonBack"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                tools:ignore="VisualClickability" />

            <com.phonewheel.ui.controls.VirtualButton
                android:id="@+id/buttonStart"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                tools:ignore="VisualClickability" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- ===== RIGHT COLUMN (25%) ===== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="25"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <!-- RT trigger button -->
            <com.phonewheel.ui.controls.VirtualButton
                android:id="@+id/buttonRT"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_margin="4dp" />

            <!-- RB shoulder button -->
            <com.phonewheel.ui.controls.VirtualButton
                android:id="@+id/buttonRB"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_margin="4dp" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Action buttons diamond -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Top row: X, Y -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.phonewheel.ui.controls.VirtualButton
                        android:id="@+id/buttonX"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_margin="6dp" />

                    <com.phonewheel.ui.controls.VirtualButton
                        android:id="@+id/buttonY"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_margin="6dp" />
                </LinearLayout>

                <!-- Bottom row: A, B -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.phonewheel.ui.controls.VirtualButton
                        android:id="@+id/buttonA"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_margin="6dp" />

                    <com.phonewheel.ui.controls.VirtualButton
                        android:id="@+id/buttonB"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_margin="6dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Right Stick + RS row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.phonewheel.ui.controls.VirtualAnalogStick
                    android:id="@+id/rightStick"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center"
                    android:layout_margin="4dp" />

                <com.phonewheel.ui.controls.VirtualButton
                    android:id="@+id/buttonRS"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_margin="4dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
