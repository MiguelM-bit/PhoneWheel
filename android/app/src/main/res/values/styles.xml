<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema escuro do PhoneWheel -->
    <style name="Theme.PhoneWheel" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_red</item>
        <item name="colorPrimaryVariant">@color/accent_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/status_connected</item>
        <item name="colorSecondaryVariant">@color/status_connected</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/status_disconnected</item>

        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Tema para diálogos de confirmação -->
    <style name="Theme.PhoneWheel.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/accent_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:background">@color/surface</item>
        <item name="dialogCornerRadius">12dp</item>
    </style>
</resources>
