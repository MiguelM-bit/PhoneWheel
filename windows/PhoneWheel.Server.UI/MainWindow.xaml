<Window x:Class="PhoneWheel.Server.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhoneWheel — Servidor"
        Height="680" Width="960"
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI"
        FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho: status de conexão -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Ellipse Grid.Column="0" Width="16" Height="16" Fill="{Binding StatusBrush}"
                     VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="18"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="{Binding LocalIpText, StringFormat='IP local: {0}'}"
                       Foreground="#9E9E9E" VerticalAlignment="Center"/>
        </Grid>

        <!-- Corpo: volante + valores -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Volante -->
            <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="320" Height="320">
                    <Grid.RenderTransform>
                        <RotateTransform Angle="{Binding WheelAngle}"/>
                    </Grid.RenderTransform>

                    <!-- Aro externo -->
                    <Ellipse Stroke="#2B2B2B" StrokeThickness="24" Fill="#151515"/>
                    <Ellipse Stroke="#3A3A3A" StrokeThickness="1" Margin="16"/>

                    <!-- Raios -->
                    <Line X1="160" Y1="160" X2="160" Y2="34" Stroke="#2B2B2B" StrokeThickness="14"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="160" Y1="160" X2="269" Y2="97" Stroke="#2B2B2B" StrokeThickness="14"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="160" Y1="160" X2="51" Y2="97" Stroke="#2B2B2B" StrokeThickness="14"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                    <!-- Cubo central -->
                    <Ellipse Width="60" Height="60" Fill="#3A3A3A"/>
                    <Ellipse Width="42" Height="42" Fill="#4A4A4A"/>

                    <!-- Marcador superior (gira com o volante) -->
                    <Ellipse Width="14" Height="14" Fill="#E53935"
                             HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
                </Grid>
            </Grid>

            <!-- Painel de valores -->
            <Grid Grid.Column="1" Margin="32,0,0,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ângulo recebido" Foreground="#9E9E9E" Margin="0,6,20,6"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ReceivedAngleText}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,6,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ângulo calibrado" Foreground="#9E9E9E" Margin="0,6,20,6"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CalibratedAngleText}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,6,0,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Normalizado" Foreground="#9E9E9E" Margin="0,6,20,6"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NormalizedText}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,6,0,6"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Gyro" Foreground="#9E9E9E" Margin="0,6,20,6"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GyroText}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,6,0,6"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Pacotes" Foreground="#9E9E9E" Margin="0,6,20,6"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PacketCountText}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,6,0,6"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Cliente" Foreground="#9E9E9E" Margin="0,6,20,6"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ClientIpText}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,6,0,6"/>
            </Grid>
        </Grid>

        <!-- Botão Iniciar/Parar -->
        <Button Grid.Row="2" Content="{Binding ToggleButtonText}" Command="{Binding ToggleCommand}"
                Width="180" Height="42" HorizontalAlignment="Left" Margin="0,8,0,0"
                FontSize="15" FontWeight="SemiBold"/>

        <!-- Painel de log -->
        <Border Grid.Row="3" Margin="0,12,0,0" Background="#141414"
                BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
            <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}"
                     Background="Transparent" BorderThickness="0"
                     Foreground="#B0B0B0" FontFamily="Consolas" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"/>
        </Border>
    </Grid>
</Window>